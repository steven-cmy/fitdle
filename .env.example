# FITDLE configuration. Copy this file to .env and edit the required block.
# Environment variables take precedence over values in .env.

# ─────────────────────────────────────────────────────────────────────────────
# 1. 部署必需 / REQUIRED DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────
# Public site origin. The exact scheme, host and port users visit.
# Derives the OAuth callback, same-origin API, cookie security, share/OG URLs
# and CORS. Do not append a trailing slash.
PUBLIC_ORIGIN=https://fitdle.example.com

# Optional API origin for a split frontend/API deployment. Leave unset when the
# site and API share one origin. The OAuth callback and browser API base are
# derived from this value.
# API_ORIGIN=https://api.example.com

# EVE SSO application Client ID. Required for real EVE login and online modes.
EVE_CLIENT_ID=

# EVE SSO application Client Secret. Required by the server only; never expose it
# to the browser or commit it.
EVE_CLIENT_SECRET=

# Random server secret used for session signing and the deterministic Daily seed.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 2. 高级玩法设置 / ADVANCED GAMEPLAY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# UTC time (HH:MM) when the game day and Daily target reset.
FITDLE_GAME_DAY_START_UTC=11:00

# Earliest killmail date (YYYY-MM-DD) allowed for Daily and random targets.
FITDLE_KB_SELECTION_START_DATE=2012-05-22

# Target-time sampling half-life in days. Smaller values favor more recent
# killmails.
FITDLE_KB_RECENCY_HALF_LIFE_DAYS=365

# Maximum zKill loss pages scanned per ship before using the pages already loaded.
FITDLE_KB_MAX_SCAN_PAGES=20

# Opening clue weight budget.
FITDLE_REVEAL_OPENING_BUDGET=9

# Maximum weight of one opening clue.
FITDLE_REVEAL_OPENING_MAX_WEIGHT=13

# Minimum number of opening clues.
FITDLE_REVEAL_OPENING_MIN_CLUES=3

# Maximum number of opening clues.
FITDLE_REVEAL_OPENING_MAX_CLUES=7

# Candidate clue count floor used by the opening planner.
FITDLE_REVEAL_CANDIDATE_FLOOR=6

# Queue weight-distribution exponent. Lower values make high-weight clues more
# likely to appear early.
FITDLE_REVEAL_QUEUE_WEIGHT_POWER=1.8

# Standard equipment budget base.
FITDLE_REVEAL_STANDARD_EQUIPMENT_BASE=4

# Standard equipment budget cap.
FITDLE_REVEAL_STANDARD_EQUIPMENT_MAX=9

# Standard equipment budget growth divisor.
FITDLE_REVEAL_STANDARD_EQUIPMENT_DIVISOR=8

# Independent Standard cargo weight budget.
FITDLE_REVEAL_STANDARD_CARGO_BUDGET=6

# Audit equipment budget added per miss.
FITDLE_REVEAL_AUDIT_EQUIPMENT_PER_MISS=1

# Audit other-clue budget base.
FITDLE_REVEAL_AUDIT_OTHER_BASE=1

# Audit equipment-shortfall transfer divisor.
FITDLE_REVEAL_AUDIT_SHORTFALL_DIVISOR=2

# Audit cargo budget divisor.
FITDLE_REVEAL_AUDIT_CARGO_DIVISOR=10

# All FITDLE_REVEAL_* values are baked into the manifest; rebuild after changing
# them.

# ─────────────────────────────────────────────────────────────────────────────
# 3. 服务运行与基础设施 / SERVICE RUNTIME & INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────
# HTTP listen port. Without a reverse proxy, it must match PUBLIC_ORIGIN.
PORT=8787

# HTTP listen address. Use 0.0.0.0 for containers or 127.0.0.1 for local-only.
HOST=0.0.0.0

# SQLite database path. On the host it defaults to .cache/fitdle-online.sqlite;
# the container image defaults to /data/fitdle.sqlite.
# For containers, use a path under /data so the volume persists it.
# DATABASE_PATH=/data/fitdle.sqlite

# Static site directory served by the Node service. Defaults to dist.
# STATIC_DIR=dist

# Development-only route /api/v1/auth/dev. Keep 0 in production.
FITDLE_DEV_AUTH=0

# Maximum room seats, including spectators and offline seats. Range: 2..32.
ROOM_MAX_PLAYERS=8

# Default number of Arbitration big rounds (full dealer rotations). Range: 1..32.
ROOM_ARBITRATION_BIG_ROUNDS=1

# Maximum big rounds the host may select. Range: 1..32.
ROOM_ARBITRATION_MAX_BIG_ROUNDS=5

# Default Timed room duration in minutes. Range: 1..60.
ROOM_TIMED_DURATION_MINUTES=10

# Maximum Timed room duration the host may select, in minutes. Range: 1..60.
ROOM_TIMED_MAX_DURATION_MINUTES=60

# Official SDE HTTP API base. Defaults to EVE's tranquility endpoint.
EVE_SDE_BASE=https://sde.evetech.net/tranquility

# Optional SSO metadata URL override. Defaults to EVE's official metadata.
# EVE_SSO_METADATA_URL=https://login.eveonline.com/.well-known/oauth-authorization-server

# Optional server log level: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
