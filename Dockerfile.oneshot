# syntax=docker/dockerfile:1

# One-shot builder: every container run clones the latest repository, rebuilds
# all generated data, and replaces the output volume with a fresh dist/.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git unzip \
  && rm -rf /var/lib/apt/lists/*

COPY docker/oneshot-entrypoint.sh /usr/local/bin/fitdle-oneshot
RUN chmod 0755 /usr/local/bin/fitdle-oneshot

ENV FITDLE_REPO=https://gitlab.com/cmy/fitdle.git \
    FITDLE_REF=main \
    OUTPUT_DIR=/out \
    PUID=99 \
    PGID=100

ENTRYPOINT ["/usr/local/bin/fitdle-oneshot"]
