{
  "name": "fitdle",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "EVE Online killboard puzzle with a lightweight online service, EVE SSO, authoritative rooms, and a practice fallback.",
  "scripts": {
    "build": "node scripts/build-catalog.mjs && node scripts/build-dist.mjs",
    "build:killpool": "node scripts/build-killpool.mjs",
    "build:weights": "node scripts/build-ship-weights.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "prepare:sde": "node scripts/prepare-sde.mjs",
    "update:sde": "node scripts/prepare-sde.mjs --refresh",
    "check:sde-cache": "node scripts/check-sde-cache.mjs",
    "update:dogma": "node scripts/update-dogma.mjs",
    "start": "node scripts/serve.mjs --root dist",
    "serve:source": "node scripts/serve.mjs --root .",
    "server:start": "node server/src/index.mjs",
    "test": "node tests/game.test.mjs && node tests/multiplayer.test.mjs && node tests/sde-api.test.mjs",
    "test:server": "npm test --prefix server",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
